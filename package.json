{
  "name": "portfolio-rahmathidyatt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
    "test": "node --import tsx --test \"src/**/*.test.{ts,tsx}\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run typecheck:tests && npm test && npm run build"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "lucide-react": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
